def get_kraken_signature(urlpath, data, secret):
    postdata = urllib.parse.urlencode(data)
    encoded = (str(data['nonce']) + postdata).encode()
    message = urlpath.encode() + hashlib.sha256(encoded).digest()
    mac = hmac.new(base64.b64decode(secret), message, hashlib.sha512)
    sigdigest = base64.b64encode(mac.digest())
    return sigdigest.decode()

def kraken_request(uri_path, data, api_key, api_sec):
    headers = {}
    headers['API-Key'] = api_key
    headers['API-Sign'] = get_kraken_signature(uri_path, data, api_sec)             
    req = requests.post((api_url + uri_path), headers=headers, data=data)
    return req

def get_api_token():
    global api_key
    global api_secret
    global api_token
    try:
        f = open(args.keyfile) 
        api_key = f.readline().strip()
        api_secret = f.readline().strip()
        f.close()
    except:
        l.error("API public key and API private (secret) key must be in a text file called API_Keys or defined with --keyfile")
        sys.exit(1)
    for retry in range(6):    
        # Opens the api websocket token
        api_nonce = bytes(str(int(time.time()*1000)), "utf-8")
        api_request = urllib.request.Request("https://api.kraken.com/0/private/GetWebSocketsToken", b"nonce=%s" % api_nonce)
        api_secret_hash = base64.b64encode( hmac.new(base64.b64decode(api_secret), 
            b"/0/private/GetWebSocketsToken" + hashlib.sha256(api_nonce + b"nonce=%s" % api_nonce).digest(), 
            hashlib.sha512).digest())
        api_request.add_header("API-Key",  api_key)
        api_request.add_header("API-Sign", api_secret_hash)
        try:
            result = urllib.request.urlopen(api_request).read()
        except:
            l.error("get_api_token: Requesting a token failed.")
            l.error("get_api_token: sleeping for 30 seconds before retrying.")         
            goodsleep(30,1)
            continue
        api_token = json.loads(result)['result']['token']
        return api_token
    # If we're here that means the for loop ended which is only cause by errors.
    l.error("get_api_token: Repeated failures occurred.  Exiting.")
    sys.exit(129)

