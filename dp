def main():

    global own_trades_data
    global coin_volume
    global winrate
    global open_orders_data
    global asset_pair_data
    global market_price

    if "--pairs" in sys.argv:
        displayAssetPairs()
        sys.exit(0)
   
    mainArgs()
    startLogging()

    l.debug("Arguments passed: %s" % str(args))
    
    # Go fetch a new API token
    get_api_token()

    if args.cancelall == 'YES':
        l.info("Cancelling all open Kraken orders now.")
        cancelAll()
        sys.exit(0)
    
    pair = getAssetPair()
    if pair == None:
        l.error("The asset pair '%s' is not valid. Exiting." % args.pair)    
        exit(1)    
    pairdata = asset_pair_data[pair]
    
    price = None

    accountbalance = getAccountBalance()
    coin_volume = float(accountbalance.get(pairdata['base'],0))
    currencyamt = accountbalance.get(pairdata['quote'],0)
    #currencyamt = 1000
    tickerData()

    if args.status == True:
        print("Wallet Status - %(c)s coins: %(amt)s, %(u)s currency: $%(uv)s" %
               {'c':pairdata['base'], 'amt':goodnum(coin_volume), 'u':pairdata['quote'], 'uv':currencyamt})
        sys.exit(0)

    l.info("%(c)s market price: %(m)s, minimum order amount: %(o)s" %
        {'c':pairdata['base'], 'm':goodnum(market_price), 'o':order_min})
    l.info("%(c)s coins: %(amt)s, %(u)s currency: $%(uv)s" % 
        {'c':pairdata['base'], 'amt':goodnum(coin_volume), 'u':pairdata['quote'], 'uv':currencyamt})
    
    price = market_price
    changed = False
    openOrders()
    for i in open_orders_data:
        txid = i
        payload     = open_orders_data.get(txid)
        descr       = payload.get('descr')
        if str(args.pair) in descr.get('pair', 'NA'):
            l.info("-- Canceling Order %(t)s: %(d)s." % 
                {'t':txid, 'd':descr}) 
            cancelOrder(txid)
            changed = True
    
    goodsleep(5)

    if changed == True:
        accountbalance = getAccountBalance()
        coin_volume = float(accountbalance.get(pairdata['base'],0))
        currencyamt = accountbalance.get(pairdata['quote'],0)
        l.info("Update after Order cancellation - %(c)s coins: %(amt)s, %(u)s currency: $%(uv)s" % 
            {'c':pairdata['base'], 'amt':goodnum(coin_volume), 'u':pairdata['quote'], 'uv':currencyamt})

    if args.cleanup == True:
        # It was requested to cancel the orders and exit.
        l.info("--cleanup requested. Orders cancelled and exiting.")
        sys.exit(0)

    if args.type == 'sell':
        l.info("Sell coins requested.  Owned volume is %s." % goodnum(coin_volume))
        if floatequal(coin_volume, 0.0):
            l.info("No coins to sell - exiting normally.")
            sys.exit(0)
        l.debug("Sell - Checking for % in volume and parsing if needed.")
        if '%' in args.volume:
            if args.volume != '100%' and args.sellall == False:
                # Calulate what the percentage is.  100% would equal coin_volume so no calucation is needed.
                old_coin_volume = coin_volume
                coin_volume = round((float(coin_volume) * (float(args.volume.split('%')[0]) / 100) ),lot_decimals) 
                l.info("Calculated sell volume requested: %(p)s of %(o)s coins = %(c)s coins." % 
                    {'p':args.volume, 'o':goodnum(old_coin_volume), 'c':goodnum(coin_volume)}) 
        elif args.volume == '0':
            l.error("Can not sell with a volume of 0.  Exiting.")
            sys.exit(5)
        else:
            # Coin Volume is a actual amount...
            coin_volume = round(float(args.volume),lot_decimals)
            l.info("Sell volume requested: %s coins" % goodnum(coin_volume)) 

        # Now check on sell price modification requests with --price...
        if args.price == '0':
            # A normal sell. execute.   
            l.info("++ Creating new %(p)s sell-market order, volume %(v)s @ price $%(m)0.4f, expiration set to %(e)s" % 
                {'p':args.pair, 'v':goodnum(coin_volume), 'm':market_price, 'e':args.timeout})
            txid = addOrder('market', 'sell', coin_volume, 0) 
            # +5 was used to extend beyond the manual cancel loop
            if txid == None:
                l.error("An Error occurred trying to create the new sell order.  Exiting.")
                exit(201)
        else:
            if '%' in args.price:
                coin_price = round(market_price + (market_price * (float(str(args.price).split('%')[0]) / 100)),pair_decimals) 
                if '-' in args.price:
                    ordertype = 'market'
                else:
                    ordertype = 'limit'
            elif '+' in args.price or '-' in args.price:
                coin_price = round(market_price + float(args.price),pair_decimals)
                ordertype = 'limit'
            else:
                # should be an actual price
                coin_price = round(float(args.price),pair_decimals)
                ordertype = 'limit'
        
            l.info("Adjusting sell price $%(m)0.4f for --price=%(p)s consideration. New sell price: $%(c)0.4f" %
                    {'m':market_price, 'p':args.price, 'c':coin_price})
        
            l.debug("Checking for market sell wait condition.") # coin price < market price
            cancelflag = False
            if float(coin_price) < float(market_price):
                # Manually wait sequence...
                l.info("oo Waiting for market price $%(m)0.4f to decrease to $%(c)0.4f to place order before timeout of %(t)s seconds" %
                    {'m':market_price,'c':coin_price,'t':args.timeout}) 
                expiretime = time.time() + int(args.timeout)
                statustime = 0
                while (coin_price < market_price):
                    if not args.timeout < 1 and time.time() > expiretime:
                        l.info("Reached timeout limit. Canceling order creation.")
                        cancelflag = True
                        break
                    goodsleep(5,1)
                    tickerData()
                    if time.time() > statustime:
                        statustime = time.time() + int(args.ufreq)
                        l.info("  Update -- Market price: $%(m)0.4f, desired sell price: $%(e)0.4f" % {'m':market_price, 'e':coin_price})
                if cancelflag == True:
                    if args.makemarket == True:
                        # So --makemarket on a limit order forces a market sell if the limit doesn't trigger.
                        # This --makemarket is strange in that it the price requested was lower than market
                        # which is a weird order.  This will basically sell at the current market price now.
                        ordertype = 'market'
                    else:
                        # This prevent further order creation logic from occuring due to timeout.
                        l.info("Exiting (101)")
                        exit(101)
                  
            l.info("++ Creating new %(p)s sell-%(o)s order, volume %(v)s @ price $%(c)0.4f expires in %(t)0.0f seconds" % 
                    {'p':args.pair, 'o':ordertype, 'v':goodnum(coin_volume), 'c':coin_price, 't':int(args.timeout)+20 })
            txid = addOrder(ordertype, 'sell', coin_volume, coin_price, int(args.timeout)+20) 
            goodsleep(2,1)
            if txid == None:
                l.error("An Error occurred trying to create the new sell order.  Aborting.")
                exit(201)
    # End sell logic
    elif args.type == 'buy':
        if floatequal(currencyamt, 0.0) == True:
            l.error("There is not enough currency available to purchase coin (min=%s). Exiting."% order_min)
            sys.exit(69)
        if args.price == '0':
            coin_price = market_price
            ordertype = 'market'
        else:
            if '%' in args.price:
                coin_price = round(market_price + (market_price * (float(str(args.price).split('%')[0]) / 100)),pair_decimals) 
                if '+' in args.price:
                    ordertype = 'market'
                else:
                    ordertype = 'limit'
            elif '+' in args.price or '-' in args.price:
                # This is for a actual price not a percentage
                coin_price = round(market_price + float(args.price),pair_decimals)
                ordertype = 'limit'
            else:
                # should be an actual price
                coin_price = round(float(args.price),pair_decimals)
                ordertype = 'limit'
            
            l.info("Adjusting market price $%(m)0.4f to price for --price=%(p)s consideration: $%(c)0.4f" %
                    {'m':market_price, 'p':args.price, 'c':coin_price})
        
        l.debug("Checking for % in volume and parsing if needed.")
        if '%' in args.volume:
            coin_volume = round((float(currencyamt) * (float(args.volume.split('%')[0]) / 100) / coin_price),lot_decimals) 
            l.info("Calculated volume requested: %(p)s of $%(ca)0.4f = %(c)s coins" % 
                {'p':args.volume, 'ca':float(currencyamt), 'c':goodnum(coin_volume)}) 
        elif args.volume == '0':
            l.error("buy can not be created with a volume of %s.  Exiting." % args.volume)
            sys.exit(5)
        else:
            coin_volume = round(float(args.volume),lot_decimals)
        l.debug("Checking for market buy wait condition.")
        # Detect if the price was defined but higher(long)/lower(short) than market.
        # Start a delay in case it is to prevent an immediate market entry.
        # This is to provide a delayed entry on a price movement you are expecting vs 
        # What Kraken does and just enters as a market regardless.
        # shortminusprice = (args.type == 'short' and coin_volume < market_price)
        cancelflag = False
        if float(coin_price) > float(market_price):
            l.info("oo Waiting for market price $%(m)0.4f to increase to $%(c)0.4f to place order before timeout of %(t)s seconds" %
                {'m':market_price,'c':coin_price,'t':args.timeout}) 
            expiretime = time.time() + int(args.timeout)
            statustime = 0
            while (coin_price >= market_price):
                if not args.timeout < 1 and time.time() > expiretime:
                    l.info("Reached timeout limit. Canceling order creation.")
                    cancelflag = True
                    break
                goodsleep(5,1)
                tickerData()
                if time.time() > statustime:
                    statustime = time.time() + int(args.ufreq)
                    l.info("  Update -- Market Price: $%(m)0.4f, Desired Entry Price: $%(e)0.4f" % {'m':market_price, 'e':coin_price})
            if cancelflag == True:
                # This prevent further order creation logic from occuring due to timeout.
                l.info("Exiting (100)")
                exit(100)
                
        l.info("++ Creating New %(p)s buy-%(o)s order, volume %(v)s @ price $%(c)0.4f expires in %(t)0.0f seconds" % 
                {'p':args.pair, 'o':ordertype, 'v':goodnum(coin_volume), 'c':coin_price, 't':int(args.timeout)+20})
        txid = addOrder(ordertype, 'buy', coin_volume, coin_price, int(args.timeout)+20) 
        goodsleep(3,1)
        if txid == None:
            l.error("An Error occurred trying to create the new order. Exiting.")
            exit(201)
    # End buy logic
    else:
        # buy or sell was not requested.
        l.error("Transaction type must be buy or sell.  Exiting")
        sys.exit(107)

    # If we're here it's time to provide status on the order...
    if args.makemarket == True:
        if args.timeout < 1:
            l.error("Error: The option --makemarket was requested with a timeout value of %s. Exiting." % args.timeout)
            sys.exit(678)
        # We need to wait for the order to execute or cancel it.
        # Expiretime will execute on a normal order without makemarket so we don't need to stick around for it otherwise.
        goodsleep(2,1) 
        l.info("oo Waiting up to %(timeout)s seconds for %(txid)s to close or cancel..." % {"timeout":int(args.timeout), 'txid':txid})
        expiretime = time.time() + int(args.timeout)
        orderdetail = 'NotNone'
        while not orderdetail == None:
            if time.time() > expiretime:
                l.info("Reached timeout limit. Canceling order %(txid)s" % {'txid':txid})
                if cancelOrder(txid) != None:
                    l.info("Order %s canceled successfully." % txid)
                else:
                    l.error("There was a problem canceling order %s. Manual intervention may be needed. Continuing anyway..." % txid)
                # Check for --makemarket option...
                if args.makemarket == True:
                    l.info("The option --makemarket was requested.  Re-submitting the canceled order as a market order.")
                    l.info("++ Creating New %(p)s %(t)s-market order, volume %(v)s" % 
                        {'p':args.pair, 't':args.type, 'v':goodnum(coin_volume)})
                    txid = addOrder('market', args.type, coin_volume, 0) 
                    if txid == None:
                        l.error("An Error occurred trying to create the new market order for --makemarket.  Aborting.")
                        sys.exit(201)
                    goodsleep(5,1)
                break
            orderdetail = getOrder(txid)
            l.debug("orderdetail = %s" % orderdetail)
            if goodsleep(3) == False:
                l.info("Received keyboard interrupt. Attempting to cancel order to abort...")
                if cancelOrder(txid) != None:
                    l.info("Order %s canceled successfully." % txid)
                sys.exit(300)

    # Provide final status update...
    goodsleep(5)

    # Report on openOrders that are remaining...
    openOrders()
    for i in open_orders_data:
        txid = i
        payload     = open_orders_data.get(txid)
        descr       = payload.get('descr')
        if str(args.pair) in descr.get('pair', 'NA'):
            l.info("Remaining openOrder: %(t)s: %(d)s." % 
                {'t':txid, 'd':descr}) 
    accountbalance = getAccountBalance()
    coin_volume = float(accountbalance.get(pairdata['base'],0))
    currencyamt = accountbalance.get(pairdata['quote'],0)
    l.info("Final update after %(t)s - %(c)s coins: %(amt)s, %(u)s currency: $%(uv)s" % 
        {'c':pairdata['base'], 't':args.type, 'amt':goodnum(coin_volume), 'u':pairdata['quote'], 'uv':currencyamt})
    
    sys.exit(0)
    
    l.info("Exiting normally.")
    sys.exit(0)



