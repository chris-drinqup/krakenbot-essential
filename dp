def goodsleep(seconds = 1, exitvalonkeyboard = None):
    try:
        time.sleep(seconds)
    except KeyboardInterrupt:
        l.debug("Received keyboard interrupt.")
        if exitvalonkeyboard != None:
            l.info("Received keyboard interrupt. Exiting.  Please manually verify the coin and order status.")
            sys.exit(exitvalonkeyboard)
        else:
            return False
    return True

def goodnum(num):
    if type(num) is float:
        s = str("%0.9f" % num)
        s = s.rstrip('0')
        if s[-1] == '.':
            s = s + '0'
        return s
    else:
        return str(num)

def floatequal(x, y):
    if type(x) is float and type(y) is float:
        if abs(float(x) - float(y)) <= 1e-10:
            return True
        else:
            return False
    else:
        return False


