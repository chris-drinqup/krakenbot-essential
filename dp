def getAssetPair(pair = None):
    global asset_pair_data
    global asset_pair
    global pair_decimals
    global lot_decimals
    global order_min
    result = list()

    if pair == None:
        pair = args.pair
    if asset_pair == None:
        try:
            resp = requests.get('https://api.kraken.com/0/public/AssetPairs')
            result = resp.json()
            #l.debug("getAssetPair: result = '%s'" % str(result))
        except KeyboardInterrupt:
            l.info("Received keyboard interrupt.")
            sys.exit(1)
        except Exception as error:
            l.error("Unable to get asset pair data from kraken. Exiting(123)")
            sys.exit(123)
        if str(result.get('error','NA')) == '[]' :                                                
            asset_pair_data = result.get('result')                                       
            #l.debug("getAssetPair asset_pair_data = '%s'" % str(asset_pair_data)) 
        else:
            l.error("Error getting asset pair data from kraken. Exiting(124)")
            sys.exit(124)
        for i in asset_pair_data:
            payload = asset_pair_data.get(i)
            if payload.get('altname','NA') == pair:
                pair_decimals = int(payload.get('pair_decimals', '2'))
                lot_decimals = int(payload.get('lot_decimals', '2'))
                order_min = float(payload.get('ordermin', '0.0'))
                l.debug("getAssetPair: returned asset_pair = '%s'" % i )
                l.debug("getAssetPair: set pair_decimals,lot_decimals=%(p)g,%(l)g" % 
                    {'p':pair_decimals, 'l':lot_decimals})
                asset_pair = i
                return asset_pair
    else:
        return asset_pair

