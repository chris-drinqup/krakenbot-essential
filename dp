def addOrder(ordtype = 'limit', otype = 'buy', volume = 0, price = 0, expiretm = None):

    if ordtype == 'limit':
        command =  {
            "nonce": str(int(1000*time.time())),
            "ordertype": "limit",
            "type": otype,
            "volume": ("{:.%sf}" % lot_decimals).format(volume).rstrip('0'),
            "pair": args.pair,
            "price": round(price,pair_decimals)
        }
    elif ordtype == 'market':
        command =  {
            "nonce": str(int(1000*time.time())),
            "ordertype": "market",
            "type": otype,
            "volume": ("{:.%sf}" % lot_decimals).format(volume).rstrip('0'),
            "pair": args.pair
        }
    elif ordtype == 'stop-loss':
        command =  {
            "nonce": str(int(1000*time.time())),
            "ordertype": "stop-loss",
            "type": otype,
            "volume": ("{:.%sf}" % lot_decimals).format(volume).rstrip('0'),
            "pair": args.pair,
            "price": round(price,pair_decimals)
        }
    if expiretm != None and ordtype != 'market':
        if not expiretm < 1: # Trap for --timeout=0
            command["expiretm"] = "+%s" % str(int(expiretm))

    if '%' in args.sell: 
        if '-' in args.sell:
            # Add a conditional stop-loss to the order:
            command["close[ordertype]"] = "stop-loss"
            command["close[price]"]     = args.sell
        else:
            # Add a conditional limit to the order:
            command["close[ordertype]"] = "limit"
            command["close[price]"]     = args.sell
    
    l.debug("addOrder: command = %s" % command)
    try:
        resp = kraken_request('/0/private/AddOrder',command, api_key, api_secret)
        result = resp.json()
        #l.debug("addOrder: result = '%s'" % json.dumps(result,indent=4))
        l.debug("addOrder: result = '%s'" % result)
    except KeyboardInterrupt:
        l.info("Received keyboard interrupt during addOrder - Ignoring.")
    except Exception as error:
        l.error("addOrder API call failed (%s)" % error)
        sys.exit(1)
    if str(result.get('error','NA')) == '[]' :
        #time.sleep(3)
        #l.debug("addOrder: Successful: '%s'" % str(result))
        result = result.get('result','{}')
        result = result.get('txid', None)[0]
        l.debug("addOrder: returning %s" % result)
        return result
    else:
        l.error("addOrder Error:  %s" % result['error']  )
        return None
        
